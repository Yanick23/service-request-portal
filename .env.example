# Base URL the SPA calls for the Service Request API.
# Leave as /api when using the built-in MSW mocks below.
VITE_API_BASE_URL=/api

# When "true", intercepts fetch calls in the browser with MSW mock handlers
# (src/mocks) instead of hitting a real backend.
VITE_USE_MOCKS=true

# OIDC provider configuration (Auth0 "Single Page Application" example).
# VITE_OIDC_AUTHORITY is the Auth0 tenant domain, with the https:// scheme,
# e.g. https://your-tenant.eu.auth0.com
VITE_OIDC_AUTHORITY=
# Client ID of the Auth0 SPA application (not a secret; safe to expose in the browser bundle).
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email
